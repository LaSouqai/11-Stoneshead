# Email delivery — use Resend OR Formspree (either one is enough)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
FORMSPREE_FORM_ID=

# Optional CRM / automation webhook
CONTACT_WEBHOOK_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Hero video (served from Vercel Blob, not the repo).
# Run: BLOB_READ_WRITE_TOKEN=... node scripts/upload-hero-to-blob.mjs _not-deployed/hero-blob
# then set this to the base URL it prints.
NEXT_PUBLIC_HERO_VIDEO_BASE=
